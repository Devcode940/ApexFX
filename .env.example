# Node 24 LTS. Build with dev dependencies; use NODE_ENV=production for the built server.
PORT=3000
NODE_ENV=development

# Public deployment URL / exact browser origins. Set these for production WebSocket clients.
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=
# Choose for your actual proxy topology. 0 disables forwarding-header trust.
# Default: private/loopback/CGNAT proxies; Vercel trusts its edge. See DEPLOYMENT.md.
TRUST_PROXY=
# Dev previews only, e.g. .e2b.app. Do not use '*' on a shared/exposed development machine.
VITE_ALLOWED_HOSTS=

# Dev preview when there is no network or provider key: a deterministic synthetic feed for
# quotes/history/calendar. NODE_ENV=production ignores it. Quotes become reference-quality, so
# paper trading and order execution stay hard-disabled while it is on. Data is always labelled 'demo'.
APEX_DEMO_FEED=false

# Preferred FX quotes/history: Tiingo REST. SERVER ONLY; never use VITE_TIINGO_API_KEY.
# Supply a token with FX permissions. Coverage (including metals) and redistribution need verification.
TIINGO_API_KEY=
# One batch TOP request for the eight catalog symbols. 10s–120s; default 90s.
TIINGO_POLL_MS=90000
# Original OHLC snapshots are cached, not fetched once per tab/chart filter. 60s–1h; default 10min.
TIINGO_HISTORY_CACHE_MS=600000
# Hard app reservations / UTC day for Tiingo only. Each REST attempt reserves 1 request + 1 unit.
# These safety caps can stop a continuously running feed; tune to your actual plan, not guessed limits.
TIINGO_DAILY_REQUESTS=900
TIINGO_DAILY_UNITS=900
# true: Tiingo -> configured Twelve Data -> Yahoo for unavailable/stale instruments/history.
# false: Tiingo-only; absence/failure stays unavailable. No data is relabeled as Tiingo.
MARKET_ALLOW_FALLBACKS=true
# Optional older sources. No key is needed to attempt Yahoo, which has no availability guarantee.
TWELVEDATA_API_KEY=
TWELVEDATA_QUOTE_SYNC_MS=900000
TWELVEDATA_POLL_MS=15000
# Optional legacy news proxy; the default UI uses the Forex Factory calendar instead.
FINNHUB_API_KEY=
FOREXRATE_API_KEY=
# live | offline. Offline is for deterministic smoke tests; it does not fabricate prices.
MARKET_DATA_MODE=live
# /api/ready requires fresh executable spot quotes for these symbols. Empty = all eight.
# Yahoo's SI=F is display-only, so require only instruments your deployment actually offers.
REQUIRED_MARKET_SYMBOLS=

# Forex Factory CURRENT-WEEK JSON economic-calendar export; not prices or a live results API.
# No source key. One upstream attempt/hour, including failures; no HTML scraping or rate-limit bypass.
FOREX_FACTORY_ENABLED=true
# Always required on Vercel. Also set true for multiple persistent Node replicas (same Redis store).
# Without Redis, one Node process has a local cache; restart loses that local cooldown/snapshot.
FOREX_FACTORY_REQUIRE_SHARED=false

# AI: configure an explicit supported TEXT model; there is no default model or automatic fallback.
# If both keys are set, OpenRouter is selected.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Default = authenticated Supabase accounts only. Explicit guests receive smaller quotas.
AI_ALLOW_GUESTS=false
AI_GLOBAL_DAILY_REQUESTS=100
AI_ACCOUNT_DAILY_REQUESTS=20
AI_GLOBAL_DAILY_UNITS=200000
AI_ACCOUNT_DAILY_UNITS=40000
AI_MAX_CONCURRENT=4

# Required for paid upstreams in production / Vercel, and for the calendar on Vercel/replicas.
# Paid requests use atomic reservations; calendar uses a shared snapshot + hourly refresh lease.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Development uses a bounded local adapter. This explicit production override is ONLY for one
# persistent process, NEVER Vercel/replicas; restart resets local quotas. Prefer shared Redis.
PAID_BUDGET_MODE=
# Other paid market providers, per UTC day. TD full batch/subscription reserves 8 units; history 1.
# Tiingo uses its separate TIINGO_DAILY_* caps above.
# Configure real provider project spend/credit caps as well: app units are not invoice guarantees.
MARKET_DAILY_REQUESTS=500
MARKET_DAILY_UNITS=800

# Browser public Supabase configuration (Vite BUILD TIME). Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side Auth verification (same project). Falls back to the VITE values if omitted.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Node read-only WebSocket transport. This Vercel handler advertises polling-only.
WS_DISABLED=false
WS_REQUIRE_AUTH=false
# Optional service-client secret: HEADER ONLY. When set, browsers must use verified Supabase Bearer
# identity for POST /api/ws/token, never this secret. One-use WS nonces still go in the upgrade URL.
WS_SHARED_SECRET=

# silent | error | warn | info. Production warnings are ON by default, not silently suppressed.
LOG_LEVEL=
# Explicit legacy opt-out only (not recommended): SHOW_WARNINGS=false
# CSP_CONNECT_EXTRA=https://your-extra-service.example
# CSP_SCRIPT_SRC='self'
