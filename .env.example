# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Alternative AI provider (OpenAI-compatible). When set,
# /api/chat routes through OpenRouter instead of Gemini. Either this or
# GEMINI_API_KEY must be configured for the AI assistant.
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL: model id to use via OpenRouter (default: openrouter/auto).
OPENROUTER_MODEL="openrouter/auto"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Third-Party Market & News APIs
FINNHUB_API_KEY=""
# TWELVEDATA_API_KEY activates Twelve Data as the primary live market source:
# WebSocket streaming ticks + REST quote/history. Without it, Yahoo Finance is used.
TWELVEDATA_API_KEY=""
# Optional tuning for Twelve Data mode (ms): REST OHLC/change sync interval and
# REST fallback poll when the WebSocket stream is stale. Each full watchlist quote
# costs 8 credits (8 API credits/min, 800/day on the free tier). 900000ms = 15 min
# (~96 credits/day, safe for free plans); paid plans may lower this.
TWELVEDATA_QUOTE_SYNC_MS=900000
TWELVEDATA_POLL_MS=15000
FOREXRATE_API_KEY=""

# Firebase Configuration (optional)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase Configuration (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
