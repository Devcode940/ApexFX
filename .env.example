# Server Configuration
PORT=3000
NODE_ENV=production

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# WebSocket Security (recommended for production)
# Set a shared secret to require x-ws-secret header for /api/ws/token
WS_SHARED_SECRET=your_random_ws_secret_here

# Distributed rate limiting (optional, for Vercel/serverless)
# Get from https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# AI Providers (set at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-...  # Optional alternative to Gemini
OPENROUTER_MODEL=openrouter/auto  # Optional: specify model

# Market Data APIs
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
TWELVEDATA_QUOTE_SYNC_MS=900000  # Optional: REST sync interval (default: 15min, min 10s, max 1h)
TWELVEDATA_POLL_MS=15000  # Optional: polling interval when WS unavailable (min 5s, max 2m)

FINNHUB_API_KEY=your_finnhub_api_key_here
FOREXRATE_API_KEY=your_forexrate_api_key_here

# Application URL (for OpenRouter)
APP_URL=https://yourdomain.com

# Logging (optional)
SHOW_WARNINGS=false  # Set to true to see warnings in production

# Firebase Configuration (optional)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase Configuration (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Added by the 2026-09-13 hardening pass -------------------------------------------
# AI model id. Never hardcode this: Google retired the previously hardcoded
# `gemini-2.0-flash` on 2026-06-01, which took the whole assistant down silently.
GEMINI_MODEL=gemini-3.5-flash

# Proxy hops to trust when deriving the client IP for rate limiting.
# LEAVE THIS EMPTY IN THE COMMON CASE - the default auto-detects:
#   unset  -> X-Forwarded-For is honoured only when the *connecting peer* is loopback/private
#             (127/8, ::1, 10/8, 172.16/12, 192.168/16, 169.254/16, fc00::/7, fe80::/10,
#             CGNAT 100.64/10). Works behind nginx/ALB/Cloudflare side-car with zero config, and a
#             client that reaches the port directly cannot forge its way to a fresh bucket.
#   1      -> exactly one reverse proxy in front, trusted regardless of its address
#   true   -> trust all hops (NOT recommended: any client can prepend values)
#   0      -> trust nothing. Use this if other tenants share your pod/VPC network and could reach
#             this port directly - they are "private" to us and therefore trusted by auto mode.
# Auto-enabled (trust all) on Vercel, whose edge always forwards.
TRUST_PROXY=

# Log verbosity: silent | error | warn | info. Defaults to "warn" in production,
# "info" otherwise. Replaces the old behaviour where info logs were hardcoded off in prod.
LOG_LEVEL=

# Return upstream error text in /api/chat responses. Defaults to true outside production.
# Helps operators distinguish "bad key" from "retired model" without shell access.
SHOW_UPSTREAM_ERRORS=false

# CSP escape hatches (only needed if you add a new direct-from-browser dependency).
# CSP_CONNECT_EXTRA=https://api.example.com
# CSP_SCRIPT_SRC='self'

# Extra Host header values the Vite DEV server should accept (comma-separated; a leading dot matches
# subdomains). Vite 6 blocks unknown hosts by default, which also blocks tunnelled/preview URLs such as
# https://3000-my-sandbox.e2b.app - the request dies with "host not allowed" before Express sees it.
# Unset = localhost only (the safe default). '*' allows any host: fine for a throwaway sandbox, not for
# a shared machine. Production is unaffected (a static build never starts the Vite server).
VITE_ALLOWED_HOSTS=
