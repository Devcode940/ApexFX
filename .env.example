# Server Configuration
PORT=3000
NODE_ENV=production

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# WebSocket Security (recommended for production)
# Set a shared secret to require x-ws-secret header for /api/ws/token
WS_SHARED_SECRET=your_random_ws_secret_here

# Distributed rate limiting (optional, for Vercel/serverless)
# Get from https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# AI Providers (set at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-...  # Optional alternative to Gemini
OPENROUTER_MODEL=openrouter/auto  # Optional: specify model

# Market Data APIs
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
TWELVEDATA_QUOTE_SYNC_MS=900000  # Optional: REST sync interval (default: 15min, min 10s, max 1h)
TWELVEDATA_POLL_MS=15000  # Optional: polling interval when WS unavailable (min 5s, max 2m)

FINNHUB_API_KEY=your_finnhub_api_key_here
FOREXRATE_API_KEY=your_forexrate_api_key_here

# Application URL (for OpenRouter)
APP_URL=https://yourdomain.com

# Logging (optional)
SHOW_WARNINGS=false  # Set to true to see warnings in production

# Firebase Configuration (optional)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase Configuration (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
